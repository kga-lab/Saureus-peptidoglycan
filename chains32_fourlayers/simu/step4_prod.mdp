integrator              = md
dt                      = 0.001
nsteps                  = 50000000      ;50 ns
nstlog                  = 1000
nstcalcenergy           = 100
nstenergy               = 1000
nstxout-compressed      = 20000           ; 20 ps sampling
compressed-x-precision  = 1000
compressed-x-grps       = System   ; OK
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
coulombtype             = pme
rcoulomb                = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
;
tcoupl                  = Nose-Hoover
tc_grps                 = glycan TIP3
tau_t                   = 1.0    1.0
ref_t                   = 310    310
;
pcoupl                  = Parrinello-Rahman
pcoupltype              = semiisotropic
tau_p                   = 5.0
compressibility         = 0.0  4.5e-5
ref_p                   = 1.0   1.0
;
constraints             = h-bonds
constraint_algorithm    = LINCS
lincs-warnangle         = 90
continuation            = yes
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = System
;
periodic-molecules       = yes
refcoord_scaling        = com
